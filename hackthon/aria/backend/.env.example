OPENAI_API_KEY=

LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
AGENT_MODEL=gpt-5.6-terra
FAST_MODEL=gpt-5.6-luna
JUDGE_MODEL=gpt-5.6-terra
EMBEDDING_MODEL=text-embedding-3-large

AGENT_REASONING_EFFORT=medium
MAX_DIAGNOSTIC_TESTS=6
INVESTIGATION_TIMEOUT_S=240

CORS_ORIGINS=http://localhost:3000

# State of the simulated cell behind every conversation. ARIA reads it only through its tools when a question needs it.
# normal_operation | gripper_feedback_missing | case_missing_photoeye | light_curtain_interlock | gripper_low_air
PLANT_SCENARIO=gripper_feedback_missing
